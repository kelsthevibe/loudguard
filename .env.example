# From https://discord.com/developers/applications
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=your-application-id

# Your server ID (right-click server -> Copy Server ID). Makes /guard appear instantly.
GUILD_ID=

# Optional
DB_PATH=data/loudguard.db

# Optional: extra "worker" bot tokens, comma-separated. Each one covers one more voice channel.
# Workers only need View Channels + Connect. The main bot does the muting.
WORKER_TOKENS=
